<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ s.title }} — {{ s.label }}</title>
<style>
  :root {
    --bg: #eef1f4;
    --panel: #ffffff;
    --ink: #16191c;
    --ink-soft: #5a636b;
    --ink-faint: #8d959c;
    --line: #ccd3da;
    --line-soft: #e4e9ee;
    --head: #d6dde4;
    --accent: #1f5f8b;
    --good: #1c6b42;
    --good-bg: #dff0e5;
    --bad: #99331f;
    --bad-bg: #fbe3dd;
    --warn-bg: #fdf3d8;
    --mono: ui-monospace, "Cascadia Code", "SF Mono", Consolas, monospace;

    /* ---- The workbook's own palette -------------------------------------
       Lifted from `Mehring Pending 4385-O Whole Chicken Datasheet.xlsx` so
       the Information Sheet and Form Response read as the sheets they
       replace. These are deliberately NOT redefined for dark mode: they are
       the sheet's identity, and a "dark beige" is just a different colour.
       Everything painted with them carries --sheet-ink so the text stays
       legible whichever theme the page is in. */
    --x-band:    #D9D9D9;  /* APPLIANCE INFORMATION / TEST CONDITIONS */
    --x-head:    #B7DEE8;  /* General Data, Test Request #: ...        */
    --x-subhead: #DBEEF4;  /* Rack Position                            */
    --x-body:    #D6D4CB;  /* the Info tab's field cells               */
    --x-alt:     #EEECE1;  /* Minimum row                              */
    --x-input:   #FFFF00;  /* fillable / annotated cells               */
    --x-soft:    #F2F2F2;  /* Food Information                         */
    --x-photo:   #4BACC6;  /* TOP / BREAST / THIGH captions            */
    --x-note:    #93CDDD;
    --x-ok:      #00DE64;
    --x-no:      #FF6B5B;
    --x-line:    #9aa3ab;
    --sheet-ink: #16191c;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --bg: #12151a;
      --panel: #1a1f26;
      --ink: #e8ecf0;
      --ink-soft: #a3adb8;
      --ink-faint: #6f7883;
      --line: #333c47;
      --line-soft: #262d36;
      --head: #232b34;
      --accent: #63a8d4;
      --good: #7fcfa0;
      --good-bg: #16301f;
      --bad: #e79880;
      --bad-bg: #3a1e17;
      --warn-bg: #352c14;
    }
  }
  * { box-sizing: border-box; }
  body {
    margin: 0; padding: 18px;
    background: var(--bg); color: var(--ink);
    font: 13px/1.45 -apple-system, "Segoe UI", Roboto, sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  .sheet { max-width: 1320px; margin: 0 auto; }

  h1.title {
    margin: 0 0 12px; padding: 9px 14px;
    background: var(--head); border: 1px solid var(--line);
    font-size: 15px; font-weight: 700; text-align: center;
    letter-spacing: .01em;
  }
  h1.title.dashtitle { margin-top: 26px; }
  .meta {
    display: flex; flex-wrap: wrap; gap: 16px;
    margin: -6px 0 14px; padding: 0 2px;
    font-size: 12px; color: var(--ink-soft);
  }
  .meta b { color: var(--ink); font-weight: 600; }
  .src {
    margin-left: auto; font-family: var(--mono); font-size: 11px;
    padding: 1px 7px; border-radius: 3px;
    background: var(--warn-bg); color: var(--ink-soft);
  }
  .src.live { background: var(--good-bg); color: var(--good); }

  .panel {
    background: var(--panel); border: 1px solid var(--line);
    margin-bottom: 14px;
  }
  .panel > h2 {
    margin: 0; padding: 6px 12px;
    background: var(--head); border-bottom: 1px solid var(--line);
    font-size: 12px; font-weight: 700;
    text-transform: uppercase; letter-spacing: .06em;
  }
  .panel > .body { padding: 12px; }

  .grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  @media (max-width: 980px) { .grid2 { grid-template-columns: 1fr; } }

  /* Summary beside the chart, matching the sheet's top band. */
  .topgrid { display: grid; grid-template-columns: minmax(300px, 400px) 1fr; gap: 14px; }
  .topgrid > .panel { margin-bottom: 14px; }
  @media (max-width: 1080px) { .topgrid { grid-template-columns: 1fr; } }

  .sumgroup { display: flex; gap: 10px; align-items: flex-start; margin-bottom: 9px; }
  .sumlabel {
    flex: 0 0 104px; padding: 5px 7px;
    background: var(--head); border: 1px solid var(--line);
    font-size: 11px; font-weight: 700; line-height: 1.25;
  }
  .sumcells { flex: 1; display: flex; flex-direction: column; gap: 3px; }
  .sumcell {
    display: flex; justify-content: space-between; gap: 10px;
    padding: 3px 7px; border: 1px solid var(--line-soft);
  }
  .sumcell .cl { color: var(--ink-soft); font-size: 11.5px; }
  .sumcell .cv {
    font-family: var(--mono); font-size: 12px;
    font-variant-numeric: tabular-nums; text-align: right;
  }
  .sumcell .cv.missing {
    color: var(--ink-faint); font-style: italic;
    font-family: inherit; font-size: 11px;
  }

  table.criteria { width: 100%; border-collapse: collapse; }
  table.criteria td, table.criteria th {
    border: 1px solid var(--line); padding: 5px 9px; font-size: 12px; text-align: left;
  }
  table.criteria tr.grouphead th {
    background: var(--head); font-size: 11px; font-weight: 700;
    text-transform: uppercase; letter-spacing: .05em;
  }
  table.criteria .pts {
    width: 108px; text-align: center;
    font-family: var(--mono); font-variant-numeric: tabular-nums;
  }
  table.criteria tr.grouphead .pts { font-family: inherit; }

  table.kv { width: 100%; border-collapse: collapse; }
  table.kv td { padding: 4px 8px; border-bottom: 1px solid var(--line-soft); vertical-align: top; }
  table.kv td.k { color: var(--ink-soft); width: 46%; }
  table.kv td.v { font-family: var(--mono); font-size: 12px; word-break: break-word; }
  table.kv tr:last-child td { border-bottom: none; }
  table.kv td.v.empty { color: var(--ink-faint); font-style: italic; font-family: inherit; }

  table.scores { width: 100%; border-collapse: collapse; text-align: center; }
  table.scores th, table.scores td { border: 1px solid var(--line); padding: 5px 4px; }
  table.scores th {
    background: var(--head); font-size: 11px; font-weight: 600;
    text-transform: uppercase; letter-spacing: .04em;
  }
  table.scores td { font-family: var(--mono); font-variant-numeric: tabular-nums; }
  table.scores td.rowlabel, table.scores th.rowlabel {
    text-align: left; font-family: inherit; background: var(--head);
    font-weight: 600; white-space: nowrap;
  }

  .total {
    display: flex; align-items: center; gap: 14px;
    margin-top: 12px; padding: 10px 14px;
    border: 1px solid var(--line); background: var(--head);
  }
  .total .n { font-family: var(--mono); font-size: 26px; font-weight: 700; font-variant-numeric: tabular-nums; }
  .total .of { color: var(--ink-soft); font-size: 12px; }
  .verdict { margin-left: auto; padding: 4px 14px; font-weight: 700; font-size: 13px; border-radius: 3px; }
  .verdict.ok { background: var(--good-bg); color: var(--good); }
  .verdict.no { background: var(--bad-bg); color: var(--bad); }
  .verdict.none { background: transparent; color: var(--ink-faint); font-style: italic; font-weight: 400; }

  .photos { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
  .photo figcaption {
    font-size: 11px; font-weight: 600; text-transform: uppercase;
    letter-spacing: .05em; text-align: center;
    padding: 4px; background: var(--head); border: 1px solid var(--line); border-bottom: none;
  }
  .photo .frame {
    border: 1px solid var(--line); aspect-ratio: 4/3;
    display: flex; align-items: center; justify-content: center;
    background: var(--bg); overflow: hidden;
  }
  .photo .frame img { width: 100%; height: 100%; object-fit: cover; }
  .photo .frame .ph {
    font-size: 11px; color: var(--ink-faint); text-align: center;
    padding: 8px; font-style: italic;
  }
  .photo figure { margin: 0; }

  .note {
    padding: 8px 12px; background: var(--warn-bg);
    border: 1px solid var(--line); font-size: 12px; color: var(--ink-soft);
  }
  .note b { color: var(--ink); }
  a { color: var(--accent); }
  :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  /* ---- Shared sheet-styled building blocks ---------------------------
     Used by the Information Sheet and Form Response sections, which mirror
     the workbook tabs. Anything inside .xl paints on the Excel palette and
     pins its own ink, so it looks identical in light and dark. */
  .xl, .xl * { color: var(--sheet-ink); }
  .xl .panelbody { padding: 12px; background: #ffffff; }

  .xl .band {
    background: var(--x-band); border: 1px solid var(--x-line);
    padding: 5px 12px; margin: 0 0 10px;
    font-size: 11px; font-weight: 700;
    text-transform: uppercase; letter-spacing: .07em; text-align: center;
  }
  .xl .band + .band, .xl .cols + .band { margin-top: 18px; }

  .xl .cols {
    display: grid; gap: 10px;
    grid-template-columns: repeat(auto-fit, minmax(215px, 1fr));
    align-items: start;
  }
  .xl .col.wide { grid-column: 1 / -1; max-width: 660px; }

  .xl h3 {
    margin: 0 0 4px; padding: 3px 7px;
    background: var(--x-head); border: 1px solid var(--x-line);
    font-size: 11px; font-weight: 700; letter-spacing: .02em;
  }
  .xl h3.sub { background: var(--x-subhead); }
  .xl h3.spaced, .xl table.xlkv.spaced { margin-top: 12px; }

  .xl table.xlkv { width: 100%; border-collapse: collapse; }
  .xl table.xlkv td {
    border: 1px solid var(--x-line); padding: 3px 7px;
    font-size: 12px; vertical-align: top; background: var(--x-body);
  }
  .xl table.xlkv td.k { width: 52%; }
  .xl table.xlkv td.v { font-family: var(--mono); word-break: break-word; }
  .xl table.xlkv td.v.missing {
    font-family: inherit; font-size: 11px; font-style: italic; opacity: .72;
  }
  .xl table.xlkv td.v.blank { font-family: inherit; opacity: .5; }

  /* Header strip of the scoring tab. */
  .xl .cols.hdr { margin-bottom: 16px; }
  .xl .bigscore {
    display: flex; align-items: center; gap: 12px;
    padding: 8px 10px; border: 1px solid var(--x-line); background: var(--x-alt);
  }
  .xl .bigscore .n {
    font-family: var(--mono); font-size: 28px; font-weight: 700;
    font-variant-numeric: tabular-nums; line-height: 1;
  }
  .xl .xverdict {
    margin-left: auto; padding: 3px 12px;
    font-size: 12px; font-weight: 700; border: 1px solid var(--x-line);
  }
  .xl .xverdict.ok { background: var(--x-ok); }
  .xl .xverdict.no { background: var(--x-no); }
  .xl .xverdict.none { background: var(--x-soft); font-weight: 400; font-style: italic; }
  .xl table.xlkv.guide td.k { font-weight: 700; }
  .xl table.xlkv.guide td.k.ok { background: var(--x-ok); }
  .xl table.xlkv.guide td.k.no { background: var(--x-no); }

  /* One panel per assessment question, mirroring the sheet's P column. */
  .xl .qgrid {
    display: grid; gap: 10px;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    align-items: start;
  }
  .xl .qblock { border: 1px solid var(--x-line); }
  .xl .qprompt {
    padding: 5px 8px; background: var(--x-head);
    font-size: 11.5px; font-weight: 700; line-height: 1.35;
    border-bottom: 1px solid var(--x-line);
  }
  .xl .qanswer {
    padding: 7px 8px; background: var(--x-input);
    font-size: 12px; line-height: 1.4; white-space: pre-wrap;
  }
  .xl .qanswer.empty {
    background: var(--x-body); font-style: italic; opacity: .7; font-size: 11px;
  }
  .xl .qnotes {
    padding: 5px 8px; background: var(--x-body);
    border-top: 1px solid var(--x-line);
    font-size: 11.5px; line-height: 1.4; white-space: pre-wrap;
  }
  .xl .qnotes::before {
    content: "Notes: "; font-weight: 700; opacity: .75;
  }

  /* Calculated values, same palette, grouped by what they feed. */
  .xl table.xlkv td.v.calc { font-weight: 600; }
  .xl .scorecell { background: var(--x-alt) !important; }
</style>
</head>
<body>
<div class="sheet">

  <h1 class="title">{{ s.title }}</h1>

  <div class="meta">
    <span>Test Request <b>{{ s.test_request_num or "—" }}</b></span>
    <span>Test <b>{{ s.test_num or "—" }}</b></span>
    <span>Food <b>{{ s.food_type or "—" }}</b></span>
    <span>Submitted <b>{{ s.timestamp or "—" }}</b></span>
    <span class="src {{ 'live' if source_name == 'graph' else '' }}">
      {{ "live · graph" if source_name == "graph" else "sample data" }}
    </span>
  </div>

  {% block content %}{% endblock %}

</div>
</body>
</html>
