<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ s.title }} — {{ s.label }}</title>
<style>
  :root {
    --bg: #eef1f4;
    --panel: #ffffff;
    --ink: #16191c;
    --ink-soft: #5a636b;
    --ink-faint: #8d959c;
    --line: #ccd3da;
    --line-soft: #e4e9ee;
    --head: #d6dde4;
    --accent: #1f5f8b;
    --good: #1c6b42;
    --good-bg: #dff0e5;
    --bad: #99331f;
    --bad-bg: #fbe3dd;
    --warn-bg: #fdf3d8;
    --mono: ui-monospace, "Cascadia Code", "SF Mono", Consolas, monospace;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --bg: #12151a;
      --panel: #1a1f26;
      --ink: #e8ecf0;
      --ink-soft: #a3adb8;
      --ink-faint: #6f7883;
      --line: #333c47;
      --line-soft: #262d36;
      --head: #232b34;
      --accent: #63a8d4;
      --good: #7fcfa0;
      --good-bg: #16301f;
      --bad: #e79880;
      --bad-bg: #3a1e17;
      --warn-bg: #352c14;
    }
  }
  * { box-sizing: border-box; }
  body {
    margin: 0; padding: 18px;
    background: var(--bg); color: var(--ink);
    font: 13px/1.45 -apple-system, "Segoe UI", Roboto, sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  .sheet { max-width: 1320px; margin: 0 auto; }

  h1.title {
    margin: 0 0 12px; padding: 9px 14px;
    background: var(--head); border: 1px solid var(--line);
    font-size: 15px; font-weight: 700; text-align: center;
    letter-spacing: .01em;
  }
  .meta {
    display: flex; flex-wrap: wrap; gap: 16px;
    margin: -6px 0 14px; padding: 0 2px;
    font-size: 12px; color: var(--ink-soft);
  }
  .meta b { color: var(--ink); font-weight: 600; }
  .src {
    margin-left: auto; font-family: var(--mono); font-size: 11px;
    padding: 1px 7px; border-radius: 3px;
    background: var(--warn-bg); color: var(--ink-soft);
  }
  .src.live { background: var(--good-bg); color: var(--good); }

  .panel {
    background: var(--panel); border: 1px solid var(--line);
    margin-bottom: 14px;
  }
  .panel > h2 {
    margin: 0; padding: 6px 12px;
    background: var(--head); border-bottom: 1px solid var(--line);
    font-size: 12px; font-weight: 700;
    text-transform: uppercase; letter-spacing: .06em;
  }
  .panel > .body { padding: 12px; }

  .grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  @media (max-width: 980px) { .grid2 { grid-template-columns: 1fr; } }

  table.kv { width: 100%; border-collapse: collapse; }
  table.kv td { padding: 4px 8px; border-bottom: 1px solid var(--line-soft); vertical-align: top; }
  table.kv td.k { color: var(--ink-soft); width: 46%; }
  table.kv td.v { font-family: var(--mono); font-size: 12px; word-break: break-word; }
  table.kv tr:last-child td { border-bottom: none; }
  table.kv td.v.empty { color: var(--ink-faint); font-style: italic; font-family: inherit; }

  table.scores { width: 100%; border-collapse: collapse; text-align: center; }
  table.scores th, table.scores td { border: 1px solid var(--line); padding: 5px 4px; }
  table.scores th {
    background: var(--head); font-size: 11px; font-weight: 600;
    text-transform: uppercase; letter-spacing: .04em;
  }
  table.scores td { font-family: var(--mono); font-variant-numeric: tabular-nums; }
  table.scores td.rowlabel, table.scores th.rowlabel {
    text-align: left; font-family: inherit; background: var(--head);
    font-weight: 600; white-space: nowrap;
  }

  .total {
    display: flex; align-items: center; gap: 14px;
    margin-top: 12px; padding: 10px 14px;
    border: 1px solid var(--line); background: var(--head);
  }
  .total .n { font-family: var(--mono); font-size: 26px; font-weight: 700; font-variant-numeric: tabular-nums; }
  .total .of { color: var(--ink-soft); font-size: 12px; }
  .verdict { margin-left: auto; padding: 4px 14px; font-weight: 700; font-size: 13px; border-radius: 3px; }
  .verdict.ok { background: var(--good-bg); color: var(--good); }
  .verdict.no { background: var(--bad-bg); color: var(--bad); }
  .verdict.none { background: transparent; color: var(--ink-faint); font-style: italic; font-weight: 400; }

  .photos { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
  .photo figcaption {
    font-size: 11px; font-weight: 600; text-transform: uppercase;
    letter-spacing: .05em; text-align: center;
    padding: 4px; background: var(--head); border: 1px solid var(--line); border-bottom: none;
  }
  .photo .frame {
    border: 1px solid var(--line); aspect-ratio: 4/3;
    display: flex; align-items: center; justify-content: center;
    background: var(--bg); overflow: hidden;
  }
  .photo .frame img { width: 100%; height: 100%; object-fit: cover; }
  .photo .frame .ph {
    font-size: 11px; color: var(--ink-faint); text-align: center;
    padding: 8px; font-style: italic;
  }
  .photo figure { margin: 0; }

  .note {
    padding: 8px 12px; background: var(--warn-bg);
    border: 1px solid var(--line); font-size: 12px; color: var(--ink-soft);
  }
  .note b { color: var(--ink); }
  a { color: var(--accent); }
  :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
</style>
</head>
<body>
<div class="sheet">

  <h1 class="title">{{ s.title }}</h1>

  <div class="meta">
    <span>Test Request <b>{{ s.test_request_num or "—" }}</b></span>
    <span>Test <b>{{ s.test_num or "—" }}</b></span>
    <span>Food <b>{{ s.food_type or "—" }}</b></span>
    <span>Submitted <b>{{ s.timestamp or "—" }}</b></span>
    <span class="src {{ 'live' if source_name == 'graph' else '' }}">
      {{ "live · graph" if source_name == "graph" else "sample data" }}
    </span>
  </div>

  {% block content %}{% endblock %}

</div>
</body>
</html>
