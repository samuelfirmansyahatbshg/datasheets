{#
  Temperature + power against time, drawn on a canvas with a clickable legend.

  Hand-rolled rather than pulling in a charting library: the page has to stay a
  single self-contained file with no CDN, and the requirement here is narrow -
  one X axis, two Y axes, toggleable series, a hover readout.

  `series` is a list of {name, axis: "temp"|"power", color, points: [[x, y], ...]}
  with x in minutes.
#}
<div class="panel">
  <h2>Temperature &amp; Power</h2>
  <div class="body">
    {% if series %}
      <div class="chart-wrap">
        <div id="legend" class="legend"></div>
        <div class="canvas-box">
          <canvas id="chart" width="1200" height="460"></canvas>
          <div id="readout" class="readout" hidden></div>
        </div>
      </div>
    {% else %}
      <div class="note">
        <b>No raw log data.</b>
        The temperature/power trace is read from the log file attached to the
        submission. It downloads through Graph, which is waiting on admin
        consent — so the chart is empty rather than showing invented numbers.
        {% if s.attachments.get("RawDataCSV") %}
          <br>Log on file: <code>{{ s.attachments["RawDataCSV"].name }}</code>
        {% endif %}
      </div>
    {% endif %}
  </div>
</div>

<style>
  .chart-wrap { display: flex; flex-direction: column; gap: 10px; }
  .legend { display: flex; flex-wrap: wrap; gap: 6px; }
  .legend button {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 3px 10px; font: inherit; font-size: 12px;
    background: var(--panel); color: var(--ink);
    border: 1px solid var(--line); border-radius: 3px; cursor: pointer;
  }
  .legend button .sw { width: 11px; height: 11px; border-radius: 2px; flex: none; }
  .legend button .ax { color: var(--ink-faint); font-size: 10px; text-transform: uppercase; }
  .legend button[aria-pressed="false"] { opacity: .4; text-decoration: line-through; }
  .legend button:hover { border-color: var(--accent); }
  .canvas-box { position: relative; }
  .canvas-box canvas { width: 100%; height: auto; display: block; touch-action: none; }
  .readout {
    position: absolute; pointer-events: none; z-index: 2;
    background: var(--panel); border: 1px solid var(--line);
    padding: 6px 9px; font-size: 11px; font-family: var(--mono);
    box-shadow: 0 2px 10px rgba(0,0,0,.18); white-space: nowrap; border-radius: 3px;
  }
  .readout .rt { font-weight: 700; margin-bottom: 3px; font-family: inherit; }
  .readout .rr { display: flex; gap: 7px; align-items: center; }
  .readout .rr .sw { width: 8px; height: 8px; border-radius: 2px; flex: none; }
</style>

{% if series %}
<script>
(function () {
  const SERIES = {{ series | tojson }};
  const canvas = document.getElementById("chart");
  const ctx = canvas.getContext("2d");
  const legendEl = document.getElementById("legend");
  const readout = document.getElementById("readout");

  // Counter columns ship switched off so they don't flatten the real traces.
  const on = SERIES.map(s => s.default_on !== false);
  const PAD = { l: 62, r: 68, t: 14, b: 42 };
  let hoverX = null;

  function css(name) {
    return getComputedStyle(document.body).getPropertyValue(name).trim();
  }

  // Build the legend; each button toggles one series and redraws.
  SERIES.forEach((s, i) => {
    const b = document.createElement("button");
    b.type = "button";
    b.setAttribute("aria-pressed", String(on[i]));
    b.innerHTML =
      '<span class="sw" style="background:' + s.color + '"></span>' +
      '<span>' + s.name + '</span>' +
      '<span class="ax">' + (s.axis === "power" ? "W" : "°F") + '</span>';
    b.addEventListener("click", () => {
      on[i] = !on[i];
      b.setAttribute("aria-pressed", String(on[i]));
      draw();
    });
    legendEl.appendChild(b);
  });

  function activeBounds() {
    let xMin = Infinity, xMax = -Infinity;
    const y = { temp: [Infinity, -Infinity], power: [Infinity, -Infinity] };
    SERIES.forEach((s, i) => {
      if (!on[i]) return;
      for (const [x, v] of s.points) {
        if (x < xMin) xMin = x;
        if (x > xMax) xMax = x;
        const b = y[s.axis];
        if (v < b[0]) b[0] = v;
        if (v > b[1]) b[1] = v;
      }
    });
    if (!isFinite(xMin)) { xMin = 0; xMax = 1; }
    if (xMax === xMin) xMax = xMin + 1;
    for (const k of ["temp", "power"]) {
      if (!isFinite(y[k][0])) y[k] = [0, 1];
      else if (y[k][0] === y[k][1]) y[k] = [y[k][0] - 1, y[k][1] + 1];
      else {
        const pad = (y[k][1] - y[k][0]) * 0.08;   // breathing room top and bottom
        y[k] = [y[k][0] - pad, y[k][1] + pad];
      }
    }
    return { xMin, xMax, y };
  }

  function draw() {
    const W = canvas.width, H = canvas.height;
    const { xMin, xMax, y } = activeBounds();
    const plotW = W - PAD.l - PAD.r;
    const plotH = H - PAD.t - PAD.b;

    const ink = css("--ink"), soft = css("--ink-soft"), line = css("--line-soft");

    ctx.clearRect(0, 0, W, H);
    ctx.lineJoin = "round";
    ctx.lineCap = "round";

    const sx = v => PAD.l + ((v - xMin) / (xMax - xMin)) * plotW;
    const sy = (v, axis) => {
      const [lo, hi] = y[axis];
      return PAD.t + plotH - ((v - lo) / (hi - lo)) * plotH;
    };

    // Grid + axis labels
    ctx.strokeStyle = line;
    ctx.fillStyle = soft;
    ctx.lineWidth = 1;
    ctx.font = "11px ui-monospace, monospace";

    ctx.textAlign = "right";
    ctx.textBaseline = "middle";
    for (let i = 0; i <= 5; i++) {
      const yy = PAD.t + (plotH * i) / 5;
      ctx.beginPath();
      ctx.moveTo(PAD.l, yy);
      ctx.lineTo(W - PAD.r, yy);
      ctx.stroke();
      const tv = y.temp[1] - ((y.temp[1] - y.temp[0]) * i) / 5;
      ctx.fillText(tv.toFixed(0), PAD.l - 8, yy);
    }
    ctx.textAlign = "left";
    for (let i = 0; i <= 5; i++) {
      const yy = PAD.t + (plotH * i) / 5;
      const pv = y.power[1] - ((y.power[1] - y.power[0]) * i) / 5;
      ctx.fillText(pv.toFixed(0), W - PAD.r + 8, yy);
    }

    ctx.textAlign = "center";
    ctx.textBaseline = "top";
    for (let i = 0; i <= 6; i++) {
      const xx = PAD.l + (plotW * i) / 6;
      ctx.beginPath();
      ctx.moveTo(xx, PAD.t);
      ctx.lineTo(xx, PAD.t + plotH);
      ctx.stroke();
      const xv = xMin + ((xMax - xMin) * i) / 6;
      ctx.fillText(xv.toFixed(1), xx, PAD.t + plotH + 8);
    }

    ctx.fillStyle = ink;
    ctx.fillText("Time (min)", PAD.l + plotW / 2, H - 15);
    ctx.save();
    ctx.translate(15, PAD.t + plotH / 2);
    ctx.rotate(-Math.PI / 2);
    ctx.textBaseline = "middle";
    ctx.fillText("Temperature (°F)", 0, 0);
    ctx.restore();
    ctx.save();
    ctx.translate(W - 14, PAD.t + plotH / 2);
    ctx.rotate(Math.PI / 2);
    ctx.fillText("Power (W)", 0, 0);
    ctx.restore();

    // Series
    SERIES.forEach((s, i) => {
      if (!on[i] || !s.points.length) return;
      ctx.strokeStyle = s.color;
      ctx.lineWidth = s.axis === "power" ? 1.2 : 1.8;
      if (s.axis === "power") ctx.setLineDash([5, 3]);
      ctx.beginPath();
      s.points.forEach(([x, v], n) => {
        const px = sx(x), py = sy(v, s.axis);
        n === 0 ? ctx.moveTo(px, py) : ctx.lineTo(px, py);
      });
      ctx.stroke();
      ctx.setLineDash([]);
    });

    if (hoverX !== null) drawHover(sx, sy, xMin, xMax, plotH);
  }

  function drawHover(sx, sy, xMin, xMax, plotH) {
    const xVal = xMin + ((hoverX - PAD.l) / (canvas.width - PAD.l - PAD.r)) * (xMax - xMin);
    ctx.strokeStyle = css("--ink-faint");
    ctx.lineWidth = 1;
    ctx.setLineDash([3, 3]);
    ctx.beginPath();
    ctx.moveTo(hoverX, PAD.t);
    ctx.lineTo(hoverX, PAD.t + plotH);
    ctx.stroke();
    ctx.setLineDash([]);

    let html = '<div class="rt">' + xVal.toFixed(2) + ' min</div>';
    let any = false;
    SERIES.forEach((s, i) => {
      if (!on[i] || !s.points.length) return;
      // Nearest sample by x - the log is dense enough that this reads as exact.
      let best = s.points[0], bestD = Math.abs(best[0] - xVal);
      for (const p of s.points) {
        const d = Math.abs(p[0] - xVal);
        if (d < bestD) { best = p; bestD = d; }
      }
      any = true;
      ctx.fillStyle = s.color;
      ctx.beginPath();
      ctx.arc(sx(best[0]), sy(best[1], s.axis), 3.2, 0, Math.PI * 2);
      ctx.fill();
      html +=
        '<div class="rr"><span class="sw" style="background:' + s.color + '"></span>' +
        s.name + ': ' + best[1].toFixed(1) + (s.axis === "power" ? " W" : " °F") + "</div>";
    });

    if (!any) { readout.hidden = true; return; }
    readout.innerHTML = html;
    readout.hidden = false;
    const scale = canvas.clientWidth / canvas.width;
    const left = hoverX * scale + 14;
    readout.style.left = Math.min(left, canvas.clientWidth - readout.offsetWidth - 8) + "px";
    readout.style.top = "14px";
  }

  canvas.addEventListener("pointermove", e => {
    const rect = canvas.getBoundingClientRect();
    const x = ((e.clientX - rect.left) / rect.width) * canvas.width;
    hoverX = (x < PAD.l || x > canvas.width - PAD.r) ? null : x;
    if (hoverX === null) readout.hidden = true;
    draw();
  });
  canvas.addEventListener("pointerleave", () => {
    hoverX = null;
    readout.hidden = true;
    draw();
  });

  // Redraw on theme flip so grid/label colours follow the tokens.
  if (window.matchMedia) {
    window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", draw);
  }

  draw();
})();
</script>
{% endif %}
