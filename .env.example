# Copy to .env and fill in. .env is gitignored - this repo is public.

# The SharePoint site holding the two lists, as Graph addresses it:
#   {hostname}:{server-relative-path}
# A personal OneDrive site looks like:
OVENDASH_SITE_PATH=contoso-my.sharepoint.com:/personal/user_contoso_com

# Sign-in authority. "organizations" works for any work account; pin it to
# your tenant domain or id if you prefer.
OVENDASH_AUTHORITY=https://login.microsoftonline.com/organizations

# List display names, if yours differ from the defaults.
OVENDASH_SCORING_LIST=Pending Scoring
OVENDASH_INFO_LIST=Test Submissions
